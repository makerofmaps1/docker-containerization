# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=environmental_data

# Optional: Override with full connection string (e.g., Supabase)
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname?sslmode=require

# Optional: Override phenology data file location for loaders
# PHENOLOGY_DATA_FILE=./dashboard/data.xlsx

# Optional: S3 source for data.xlsx
# S3_BUCKET=your-bucket
# S3_KEY=raw-data/data.xlsx
# AWS_REGION=us-east-1
# PHENOLOGY_CACHE_DIR=/tmp
# RDS Database
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=myappdb
DB_USER=postgres
DB_PASSWORD=

# AWS Credentials (for local development)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Production flag
USE_SECRETS_MANAGER=false
# When using Secrets Manager, set the secret name here
# AWS_SECRET_NAME=myapp/database

# Service Ports
DB_PORT=5432
DASHBOARD_PORT=8501
